// Schema de Prisma — Conecta Inversión
// Ejecutar: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS ───────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          UserRol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  empresa       Empresa?
  banco         Banco?
  inversor      Inversor?
  notificaciones Notificacion[]
  tokensCreados  TokenRegistro[]        @relation("TokensCreadosPorAdmin")
  tokenUsado     TokenRegistro?         @relation("TokenUsadoPorUser")
  refreshTokens  RefreshToken[]
  mfaSecret      MfaSecret?
  kycInversor    KycInversor?
  dispositivos   DispositivoConocido[]
  deviceTokens   DeviceVerificationToken[]
  sesionBanco    SesionBanco[]
  webAuthnCreds  WebAuthnCredential[]
  eFirma         EFirmaEmpresa?
  subRoles       SubRolEmpresa[]

  @@map("users")
}

enum UserRol {
  empresa
  banco
  inversor
  admin
}

// ─── PERFILES ───────────────────────────────────────────────

model Empresa {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  nombreEmpresa   String   @map("nombre_empresa")
  rfc             String   @unique
  sectorScian     String   @map("sector_scian")
  aniosOperacion  Int      @map("anios_operacion")
  numEmpleados    Int      @map("num_empleados")
  ingresosAnuales Decimal  @map("ingresos_anuales")
  deudasActuales  Decimal  @map("deudas_actuales")
  documentoUrl    String?  @map("documento_url")

  user      User        @relation(fields: [userId], references: [id])
  proyectos Proyecto[]

  @@map("empresas")
}

model Banco {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  nombreInstitucional String   @map("nombre_institucional")
  claveBanxico        String   @map("clave_banxico")
  contactoGestor      String   @map("contacto_gestor")
  rfc                 String   @unique
  suspendido          Boolean  @default(false)

  user          User               @relation(fields: [userId], references: [id])
  propuestas    PropuestaBanco[]
  ipWhitelist   IpWhitelistBanco[]

  @@map("bancos")
}

model Inversor {
  id               String             @id @default(uuid())
  userId           String             @unique @map("user_id")
  nombreCompleto   String             @map("nombre_completo")
  rfcCurp          String             @map("rfc_curp")
  capitalDisponible Decimal           @map("capital_disponible")
  preferencia      TipoFinanciamiento
  sectoresInteres  String             @map("sectores_interes")

  user         User          @relation(fields: [userId], references: [id])
  negociaciones Negociacion[]

  @@map("inversores")
}

// ─── PROYECTOS ───────────────────────────────────────────────

model Proyecto {
  id                  String            @id @default(uuid())
  empresaId           String            @map("empresa_id")
  titulo              String
  descripcion         String
  montoMin            Decimal           @map("monto_min")
  montoMax            Decimal           @map("monto_max")
  porcentajeAcciones  Decimal?          @map("porcentaje_acciones")
  tipoFinanciamiento  TipoFinanciamiento @map("tipo_financiamiento")
  estado              EstadoProyecto    @default(borrador)
  totalInvertido      Decimal           @default(0) @map("total_invertido")
  createdAt           DateTime          @default(now()) @map("created_at")

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  solicitudesBanco  SolicitudBanco[]
  negociaciones     Negociacion[]

  @@map("proyectos")
}

enum EstadoProyecto {
  borrador
  publicado
  en_revision_banco
  financiado_banco
  financiado_inversor
  financiado_total
  eliminado
}

enum TipoFinanciamiento {
  acciones
  prestamo
  ambos
}

// ─── PROPUESTAS Y SOLICITUDES DE BANCO ───────────────────────

model PropuestaBanco {
  id          String   @id @default(uuid())
  bancoId     String   @map("banco_id")
  nombre      String
  requisitos  String
  montoFijo   Decimal  @map("monto_fijo")
  tasaInteres Decimal  @map("tasa_interes")
  activa      Boolean  @default(true)

  banco      Banco            @relation(fields: [bancoId], references: [id])
  solicitudes SolicitudBanco[]

  @@map("propuestas_banco")
}

model SolicitudBanco {
  id                  String               @id @default(uuid())
  proyectoId          String               @map("proyecto_id")
  propuestaBancoId    String               @map("propuesta_banco_id")
  estado              EstadoSolicitudBanco @default(en_revision)
  contraofertaDetalle String?              @map("contraoferta_detalle")
  expiraEn            DateTime?            @map("expira_en")
  createdAt           DateTime             @default(now()) @map("created_at")

  proyecto      Proyecto       @relation(fields: [proyectoId], references: [id])
  propuestaBanco PropuestaBanco @relation(fields: [propuestaBancoId], references: [id])

  @@map("solicitudes_banco")
}

enum EstadoSolicitudBanco {
  en_revision
  aceptada
  rechazada
  contraoferta_pendiente
  expirada
}

// ─── NEGOCIACIONES INVERSOR ───────────────────────────────────

model Negociacion {
  id                String            @id @default(uuid())
  proyectoId        String            @map("proyecto_id")
  inversorId        String            @map("inversor_id")
  montoOfertado     Decimal           @map("monto_ofertado")
  montoContraoferta Decimal?          @map("monto_contraoferta")
  tipo              TipoFinanciamiento
  estado            EstadoNegociacion @default(pendiente)
  expiraEn          DateTime?         @map("expira_en")
  createdAt         DateTime          @default(now()) @map("created_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id])
  inversor Inversor @relation(fields: [inversorId], references: [id])

  @@map("negociaciones")
}

enum EstadoNegociacion {
  pendiente
  contraoferta
  aceptada
  rechazada
  expirada
}

// ─── NOTIFICACIONES ──────────────────────────────────────────

model Notificacion {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  mensaje   String
  tipo      TipoNotificacion
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notificaciones")
}

enum TipoNotificacion {
  oferta_recibida
  contraoferta
  proyecto_aceptado
}

// ─── CMS ─────────────────────────────────────────────────────

model CmsContenido {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  titulo     String
  cuerpo     String
  archivoUrl String?  @map("archivo_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("cms_contenido")
}

// ─── TOKENS DE REGISTRO ──────────────────────────────────────

model TokenRegistro {
  id             String         @id @default(uuid())
  token          String         @unique @default(uuid())
  rolDestino     UserRol        @map("rol_destino")
  usado          Boolean        @default(false)
  creadoPorAdminId String       @map("creado_por_admin_id")
  expiraEn       DateTime       @map("expira_en")
  usadoPorUserId String?        @unique @map("usado_por_user_id")

  creadoPorAdmin User  @relation("TokensCreadosPorAdmin", fields: [creadoPorAdminId], references: [id])
  usadoPorUser   User? @relation("TokenUsadoPorUser", fields: [usadoPorUserId], references: [id])

  @@map("tokens_registro")
}

// ─── REFRESH TOKENS ──────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiraEn  DateTime @map("expira_en")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// ─── MFA / TOTP ───────────────────────────────────────────────
// Secreto TOTP vinculado a un usuario (EMPRESA e INVERSOR)

model MfaSecret {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  secret    String                        // Base32, cifrado en reposo
  habilitado Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("mfa_secrets")
}

// ─── KYC INVERSORES ───────────────────────────────────────────
// Registro del proceso de verificación de identidad para inversores

model KycInversor {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  estado          KycEstado @default(pendiente)
  documentoUrl    String?   @map("documento_url")   // INE / Pasaporte
  livenessUrl     String?   @map("liveness_url")    // Prueba de vida
  revisadoPorAdmin Boolean  @default(false) @map("revisado_por_admin")
  notas           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("kyc_inversores")
}

enum KycEstado {
  pendiente
  en_revision
  aprobado
  rechazado
}

// ─── DISPOSITIVOS CONOCIDOS (INVERSORES) ──────────────────────
// Para detección de dispositivos nuevos y envío de magic link

model DispositivoConocido {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  deviceHash   String   @map("device_hash")  // Hash de User-Agent + fingerprint
  nombre       String?                        // Ej. "Chrome en MacBook"
  verificado   Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceHash])
  @@map("dispositivos_conocidos")
}

// ─── TOKENS DE VERIFICACIÓN DE DISPOSITIVO ────────────────────
// Magic link para confirmar dispositivo nuevo del inversor

model DeviceVerificationToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique @default(uuid())
  deviceHash String   @map("device_hash")
  expiraEn   DateTime @map("expira_en")
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("device_verification_tokens")
}

// ─── IP WHITELIST (BANCOS) ────────────────────────────────────
// Rangos de IP institucionales autorizados por banco

model IpWhitelistBanco {
  id        String   @id @default(uuid())
  bancoId   String   @map("banco_id")
  cidr      String                      // Ej. "200.57.128.0/24"
  descripcion String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  banco Banco @relation(fields: [bancoId], references: [id])

  @@map("ip_whitelist_banco")
}

// ─── INTENTOS DE LOGIN FALLIDOS ───────────────────────────────
// Para bloqueo por fuerza bruta

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String
  exitoso   Boolean  @default(false)
  bloqueado Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ─── SESIONES BANCO (JWT DPoP corta duración) ─────────────────

model SesionBanco {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  accessToken  String   @unique @map("access_token")   // Hash del JWT
  ip           String
  userAgent    String   @map("user_agent")
  expiraEn     DateTime @map("expira_en")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sesiones_banco")
}

// ─── PASSKEYS / WEBAUTHN (INVERSORES) ────────────────────────
// Credenciales WebAuthn registradas por un inversor

model WebAuthnCredential {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  credentialId   String   @unique @map("credential_id")  // Base64URL
  publicKey      Bytes    @map("public_key")              // COSE key
  counter        Int      @default(0)
  deviceType     String?  @map("device_type")             // "platform" | "cross-platform"
  nombre         String?                                   // Ej. "Face ID en iPhone"
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("webauthn_credentials")
}

// ─── E.FIRMA SAT (EMPRESAS) ───────────────────────────────────
// Metadatos del certificado e.Firma vinculado a una empresa

model EFirmaEmpresa {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  rfcExtraido     String   @map("rfc_extraido")           // RFC del .cer
  razonSocialExtraida String @map("razon_social_extraida")
  serialCertificado String @map("serial_certificado")     // Número de serie del cert
  vigenciaDesde   DateTime @map("vigencia_desde")
  vigenciaHasta   DateTime @map("vigencia_hasta")
  revocado        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("efirma_empresas")
}

// ─── SUB-ROLES EMPRESA ────────────────────────────────────────
// RBAC interno dentro del perfil de empresa

model SubRolEmpresa {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  subRol    SubRolEmpresaTipo @map("sub_rol")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, subRol])
  @@map("sub_roles_empresa")
}

enum SubRolEmpresaTipo {
  lectura
  firmante
  operador
}
